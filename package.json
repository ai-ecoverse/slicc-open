{
  "name": "@ai-ecoverse/slicc-open",
  "version": "0.0.0",
  "description": "open and xdg-open for SLICC: URLs, OPFS files, downloads and inline images in the browser, and scopen for any host",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-open.git"
  },
  "engines": {
    "node": ">=24",
    "slicc-kernel": ">=1.153.0"
  },
  "bin": {
    "scopen": "host/scopen.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-open",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "unitSources": [
      "host"
    ],
    "commands": {
      "open": {
        "script": "bin/open"
      },
      "xdg-open": {
        "script": "bin/xdg-open"
      },
      "scopen": {
        "script": "bin/scopen"
      }
    }
  },
  "files": [
    "bin",
    "host"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint && shellcheck -s sh -e SC1091 install.sh bin/* && for f in install.sh bin/*; do dash -n \"$f\" || exit 1; done",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:windows": "node --test --test-concurrency=1 --test-timeout=600000 test/integration/host.test.mjs test/integration/windows.test.mjs",
    "test:unit": "node scripts/cover.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.153.0",
    "@ai-ecoverse/slicc-shared-web": "2.12.0",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9",
    "slicc-kernel-without-embedder": "npm:@ai-ecoverse/slicc-kernel@1.152.2"
  }
}
