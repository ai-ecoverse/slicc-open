{
  "name": "@ai-ecoverse/slicc-open",
  "version": "0.0.0",
  "description": "open and xdg-open for SLICC: URLs, OPFS files, downloads and inline images in the browser, and scopen for any host",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-open.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "scopen": "host/scopen.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-open",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "unitSources": [
      "host"
    ]
  },
  "files": [
    "bin",
    "host"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:unit": "node scripts/cover.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.11.3",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
